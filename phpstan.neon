includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Following-beta blocking target approved in organisation #127.
	# Levels 6–8 remain separate diagnostic/typing work.
	level: 5
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- tests/Booster/GitHub/bootstrap.php
		- tests/Booster/GitHub/ReleaseDeployments/WorkflowAssistance/WorkflowAssistanceTestBootstrap.php
	paths:
		- src
		- tests/foundation-contract.php

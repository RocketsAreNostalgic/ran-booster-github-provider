includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Following-beta blocking target approved in organisation #127.
	# Levels 6–8 remain separate diagnostic/typing work.
	level: 5
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- tests/Booster/GitHub/bootstrap.php
		- tests/Booster/GitHub/ReleaseDeployments/WorkflowAssistance/WorkflowAssistanceTestBootstrap.php
	paths:
		- .
	# Retain directly analyzed foundation contract; exclude only host/test-fixture roles.
	excludePaths:
		analyseAndScan:
			- tests/Booster/*
			- tests/Support/*
			- tests/fixtures/*
			- scripts/*
			- vendor/*
			- node_modules/*
			- .git/*
			- .phpstan/*
			- .phpunit.cache/*
			- tests/host-contract.php
			- tests/analysis-coverage.php
